{
  "version": "2.0.0",
  "tasks": [

    // ── Infrastructure ──────────────────────────────────────
    {
      "label": "Docker: Start infra (Postgres + Redis)",
      "type": "shell",
      "command": "docker compose up -d postgres redis",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Docker: Start all services",
      "type": "shell",
      "command": "docker compose up -d --build",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Docker: Stop all",
      "type": "shell",
      "command": "docker compose down",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },

    // ── Individual services (all load .env automatically) ────
    {
      "label": "Run: auth-service (port 8087)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File dev/Start-Service.ps1 auth-service",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "dependsOn": "Docker: Start infra (Postgres + Redis)",
      "problemMatcher": ["$javac"]
    },
    {
      "label": "Run: patient-identity-service (port 8081)",
