    // ── Frontend ─────────────────────────────────────────────
    {
      "label": "Run: frontend dev server (port 5173)",
      "type": "shell",
      "command": "cd medic-frontend && npm install && npm run dev",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },

    // ── Build ─────────────────────────────────────────────────
    {
      "label": "Maven: Build all (skip tests)",
      "type": "shell",
      "command": "mvn clean package -DskipTests -q",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": ["$javac"]
    },
    {
      "label": "Maven: Run all tests",
