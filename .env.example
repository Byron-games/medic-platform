# ══════════════════════════════════════════════════
# M.E.D.I.C. Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ══════════════════════════════════════════════════

# ── Security (REQUIRED) ────────────────────────────
# Must be at least 32 characters. Generate with:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-char-secret-string-here

# ── Database (REQUIRED) ────────────────────────────
DB_USER=medic
DB_PASSWORD=change-me-strong-db-password

# ── Redis (REQUIRED) ──────────────────────────────
REDIS_PASSWORD=change-me-strong-redis-password

# ── SMS / Notifications (optional for local dev) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=sandbox

# ── Telemedicine ───────────────────────────────────
JITSI_SERVER_URL=https://meet.jit.si

# ── Monitoring ─────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-grafana-password

# ── Domain (for VPS deployment) ───────────────────
DOMAIN=medic.health
ADMIN_EMAIL=admin@medic.health
