# ══════════════════════════════════════════════════════════════
# M.E.D.I.C. Platform — Environment Variables
# ══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# Run: cp .env.example .env
# NEVER commit .env to Git — it is in .gitignore.
# ══════════════════════════════════════════════════════════════

# ── Security (REQUIRED) ────────────────────────────────────────
# Must be at least 32 characters.
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-char-secret-string-here-please

# ── Database (REQUIRED) ────────────────────────────────────────
DB_USER=medic
DB_PASSWORD=change-me-strong-db-password-here

# ── Redis (REQUIRED) ──────────────────────────────────────────
REDIS_PASSWORD=change-me-strong-redis-password-here

# ── Africa's Talking SMS (optional for local dev) ─────────────
# Leave blank to use the stub provider (logs to console).
# Get keys from: https://account.africastalking.com
# Use username=sandbox + simulator for free testing:
# https://simulator.africastalking.com
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_SENDER_ID=MEDIC

# ── Telemedicine ───────────────────────────────────────────────
# Public Jitsi for dev. In production: your own Jitsi instance.
JITSI_SERVER_URL=https://meet.jit.si
# Base URL used to generate patient SMS join links
APP_BASE_URL=http://localhost:8084

# ── Inter-service communication ────────────────────────────────
# Used by appointment-service to call notification-service
NOTIFICATION_SERVICE_URL=http://notification-service:8088

# ── Monitoring ─────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-grafana-password

# ── Domain (for VPS production deployment) ─────────────────────
DOMAIN=medic.health
ADMIN_EMAIL=admin@medic.health

# ══════════════════════════════════════════════════════════════
# DEFAULT CREDENTIALS (CHANGE BEFORE GOING LIVE)
# ══════════════════════════════════════════════════════════════
# Database login: admin / Admin@123
# Grafana: admin / (your GRAFANA_PASSWORD above)
# ══════════════════════════════════════════════════════════════
